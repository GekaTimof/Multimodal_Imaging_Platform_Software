[Unit]
Description=Raspberry Pi Spectrometer Service
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/home/minilumi/Multimodal_Imaging_Platform_Software/RaspberryPi
ExecStart=/usr/bin/python3 -c "
import sys
sys.path.insert(0, '/home/minilumi/Multimodal_Imaging_Platform_Software/RaspberryPi')
from src.services.spectrometer_service import SpectrometerService
from src.core.spectrum_streaming import SpectrumStreamServer

service = SpectrometerService(fps=10)
service.start()
server = SpectrumStreamServer(host='0.0.0.0', port=8081, spectrometer_service=service)
server.run()
"
Restart=always
RestartSec=5
User=minilumi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/minilumi/Multimodal_Imaging_Platform_Software/RaspberryPi
EnvironmentFile=-/home/minilumi/Multimodal_Imaging_Platform_Software/RaspberryPi/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
