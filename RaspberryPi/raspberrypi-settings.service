[Unit]
Description=Raspberry Pi Settings API Server
After=network.target
Wants=network.target

[Service]
Type=simple
WorkingDirectory=/home/minilumi/Multimodal_Imaging_Platform_Software/RaspberryPi
ExecStart=/usr/bin/python3 /home/minilumi/Multimodal_Imaging_Platform_Software/RaspberryPi/main.py
Restart=always
RestartSec=5
User=minilumi
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/minilumi/Multimodal_Imaging_Platform_Software/RaspberryPi
EnvironmentFile=-/home/minilumi/Multimodal_Imaging_Platform_Software/RaspberryPi/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
