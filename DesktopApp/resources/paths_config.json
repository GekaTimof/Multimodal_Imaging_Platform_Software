{
    "file_operations": {
        "photo": {
            "default_save_dir": "C:/Users/Evgeniy/Downloads",
            "filename_template": "camera_snapshot_{timestamp}.png",
            "format": "PNG",
            "allowed_formats": [
                "PNG",
                "JPG",
                "JPEG",
                "BMP",
                "TIFF"
            ],
            "create_subdirs": false,
            "subdir_format": "{date}"
        },
        "spectrum": {
            "default_save_dir": "/home/evgeniy/Downloads",
            "filename_template": "spectrum_{timestamp}.txt",
            "format": "TXT",
            "allowed_formats": [
                "TXT",
                "CSV",
                "JSON"
            ],
            "create_subdirs": false,
            "subdir_format": "{date}"
        },
        "Acquisition": {
            "default_save_dir": "",
            "filename_template": "Acquisition_analysis_{timestamp}.csv",
            "format": "CSV",
            "allowed_formats": [
                "CSV",
                "XLSX",
                "JSON"
            ],
            "create_subdirs": false,
            "subdir_format": "{date}"
        },
        "logs": {
            "default_save_dir": "",
            "filename_template": "app_log_{date}.txt",
            "format": "TXT",
            "max_log_files": 10
        }
    },
    "path_validation": {
        "require_home_subdir": true,
        "allowed_base_dirs": [
            "home",
            "downloads",
            "documents",
            "desktop",
            "app_data"
        ],
        "max_path_length": 255,
        "forbidden_chars": [
            "<",
            ">",
            ":",
            "\"",
            "|",
            "?",
            "*"
        ]
    },
    "base_directories": {
        "home": "",
        "downloads": "",
        "documents": "",
        "desktop": "",
        "app_data": ""
    }
}